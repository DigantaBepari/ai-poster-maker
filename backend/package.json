{
  "name": "poster-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "seed": "node --env-file-if-exists=.env --import tsx src/seed/index.ts"
  },
  "dependencies": {
    "bcrypt": "^6",
    "cloudinary": "^2",
    "cors": "^2",
    "express": "^5",
    "express-rate-limit": "^8",
    "helmet": "^8",
    "jsonwebtoken": "^9",
    "mongoose": "^8",
    "multer": "^2",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6",
    "@types/cors": "^2",
    "@types/express": "^5",
    "@types/jsonwebtoken": "^9",
    "@types/multer": "^2",
    "@types/node": "^24",
    "@types/supertest": "^6",
    "eslint": "^9",
    "mongodb-memory-server": "^10",
    "prettier": "^3.9.9",
    "supertest": "^7",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^5.0.3"
  }
}
